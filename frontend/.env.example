# 未設定または true のときはブラウザ内モックで動作します。
VITE_USE_MOCK_API=true

# デプロイ後に設定してください。末尾のスラッシュは不要です。
# VITE_API_BASE_URL=https://YOUR_API_URL

# App Check (firebase apps:sdkconfig WEB <appId> --project real-conversation-agents
# で取得できる値。未設定ならApp Checkトークンは付与されずmonitorモード相当になる)。
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_RECAPTCHA_SITE_KEY=
