# このファイルには値を入れず、必要なキー名だけを記載する（docs/CONTRIBUTION.md §12.3）。
# 実際の値は .env にコピーして入れる（.env はgitignore対象）。
#
# frontend/ 固有の VITE_* 変数は frontend/.env.example を参照。

# =======================================================
# Secret Manager（このファイルからは読まれない。値の置き場所を示すチェックリスト）
# =======================================================
# api/src/services/secret_manager_client.py が実行時にSecret Manager APIから
# 直接取得する。ここに値を書いても読み込まれない。
# 実際の投入は `gcloud secrets versions add <name> --data-file=-` 等で行う
# （docs/infra/02_PARAMS_DEF.md §4、infra/terraform/modules/secret-manager）。
#
# 名前は環境サフィックス付き（-dev / -prod）。単一プロジェクト内でdev/prodが
# 同じシークレット名を取り合わないようにするため（infra/terraform/environments/*/variables.tf）。
#
# shared-auth-username-{dev,prod}        … 共有ログインのユーザー名（平文）
# shared-auth-password-hash-{dev,prod}   … 共有ログインのパスワード（bcryptハッシュを保存。平文は保存しない）
# token-signing-secret-{dev,prod}        … 短期access token / stream ticket の署名鍵
# x-api-bearer-token-{dev,prod}          … X API認証（現状ダミー実装のため未使用）
# app-check-debug-token-dev              … App Check debugトークン（devのみ。local/CI用）

# =======================================================
# api/ ローカル開発用（api/src/config.py が .env から読む）
# =======================================================
GCP_PROJECT_ID=
GCP_REGION=us-central1
ENVIRONMENT=dev

FIRESTORE_DATABASE_ID=dev

# agent/deploy.py（create）実行後に確定する値
AGENT_ENGINE_RESOURCE_NAME=

CLOUD_TASKS_QUEUE_NAME=
CLOUD_TASKS_INVOKER_SA_EMAIL=

# frontendのローカル開発URL（例: http://localhost:5173）
CORS_ALLOWED_ORIGINS=

AUTH_TOKEN_TTL_SECONDS=3600
STREAM_TICKET_TTL_SECONDS=60
SESSION_MAX_DURATION_SECONDS=600
MAX_CONCURRENT_SESSIONS=5

# Cloud Run 1インスタンスあたりの上限（docs/infra/03_SECURITY.md §7）
RATE_LIMIT_PER_IP_PER_MINUTE=20
CLOUD_RUN_MAX_INSTANCES=2

# monitor: 失敗してもログのみ / enforce: 失敗を401にする
APP_CHECK_ENFORCEMENT_MODE=monitor
FIREBASE_PROJECT_ID=

LOG_LEVEL=debug
